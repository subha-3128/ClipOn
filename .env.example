# Speech-to-Text Transcription (Cloud & Local)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
WHISPER_MODEL=base

# LLM Providers for Viral Moment Ranking & Hook Analysis
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_MODEL=llama3.2

# NVIDIA Active Speaker Detection (ASD) & Speaker Association
# Cloud NIM / NVCF Endpoint for neural active speaker inference
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_ASD_FUNCTION_ID=your_nvidia_nvcf_function_id_here
# NVIDIA_ASD_ENDPOINT=https://api.nvcf.nvidia.com/v2/nvcf/pexec/functions
# NVIDIA_ASD_AUDIO_MODE=embedded

# Instagram Reels Publishing & Webhook Automation
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_meta_access_token_here
INSTAGRAM_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_url_here

# YouTube Shorts Direct Upload (Google Cloud OAuth2 Data API v3)
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Studio Storage Destinations (defaults: ~/Downloads/ClipOn and ~/Documents/ClipOn)
CLIPON_YOUTUBE_DIR=
CLIPON_CLIPS_DIR=
